# Portal (Hydrogen / Oxygen) — copie para .env e preencha.
# Em produção estes valores NÃO vêm deste arquivo: configure em
# Hydrogen → Storefront → Environments no admin da Shopify.
# `npx shopify hydrogen env pull` traz os valores do storefront linkado.

# --- API própria (conteúdo editorial) ---
PUBLIC_GRAPHQL_URL=http://localhost:4010/graphql
PUBLIC_SITE_URL=http://localhost:3001
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- Shopify Storefront API (Loja NTV) ---
PUBLIC_STORE_DOMAIN=sua-loja.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STOREFRONT_ID=
PRIVATE_STOREFRONT_API_TOKEN=
PUBLIC_CHECKOUT_DOMAIN=
SHOP_ID=
