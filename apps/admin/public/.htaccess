# O admin é uma SPA: só existe um index.html, e as rotas (/posts, /midia, ...)
# são resolvidas no browser pelo BrowserRouter. Sem esta regra, abrir ou dar
# F5 numa rota interna faz o Apache procurar um arquivo que não existe e devolver 404.
#
# O Vite copia tudo de public/ para dist/, então este arquivo já sai no build.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Arquivo ou diretório real (JS, CSS, imagens) é servido direto.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Qualquer outra coisa cai no index.html e quem decide é o router.
  RewriteRule ^ index.html [L]
</IfModule>

# Os assets do Vite têm hash no nome, então podem ser cacheados para sempre.
# O index.html não: é ele que aponta para os hashes novos a cada deploy.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|png|jpg|jpeg|webp|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
