# Fonte única de env em dev — a apps/api lê este arquivo da raiz.
# Copie para .env: `cp .env.example .env`
#
# As portas fogem do padrão porque o stack antigo em ../NTV-NEWS já ocupa
# 27017 e 4000 nesta máquina.

MONGODB_URI=mongodb://localhost:27021/ntv_news
API_PORT=4010
PUBLIC_API_URL=http://localhost:4010
JWT_SECRET=dev-secret-nao-usar-em-producao

# Origens do browser que podem chamar a API: admin (5174) e portal (3001).
# O SSR do portal é server-to-server e não manda Origin, então não precisa entrar aqui.
# Ao publicar no Oxygen, acrescente o domínio do storefront.
CORS_ORIGINS=http://localhost:5174,http://localhost:3001

UPLOADS_DIR=./uploads

# Lido pelo admin no momento do BUILD (o vite.config aponta o envDir para esta raiz).
# Ao gerar o bundle que vai para a hospedagem, use a URL pública da API —
# o valor fica embutido no JS, então mudar depois exige rebuild.
VITE_GRAPHQL_URL=http://localhost:4010/graphql

# Opcionais — sem eles, os jogos vêm só do que for cadastrado no admin.
FOOTBALL_DATA_TOKEN=
THESPORTSDB_KEY=3
